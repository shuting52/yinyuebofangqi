<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FAFAFA"
    android:paddingHorizontal="12dp"
    android:elevation="8dp"
    android:visibility="gone">

    <!-- 封面 -->
    <ImageView
        android:id="@+id/iv_mini_cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_album_placeholder" />

    <!-- 歌曲信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="歌曲名"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="歌手"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 控制按钮 -->
    <ImageView
        android:id="@+id/iv_mini_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_next"
        app:tint="@color/text_primary"
        android:contentDescription="下一首" />

    <ImageView
        android:id="@+id/iv_mini_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        app:tint="@color/primary"
        android:contentDescription="播放/暂停" />

</LinearLayout>
